# Copia este fichero a .env y rellena los valores.
# .env esta en .gitignore y no se sube nunca.

MYSQL_DATABASE=polaris
MYSQL_USER=polaris
MYSQL_PASSWORD=cambiame
MYSQL_ROOT_PASSWORD=cambiame-tambien
MYSQL_PORT=3306

# Las lee application.yml para conectar el backend.
# Deben coincidir con las de arriba.
POLARIS_DB_URL=jdbc:mysql://localhost:3306/polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=cambiame

# OAuth2 con Google (B1). Se sacan de Google Cloud Console:
# APIs y servicios -> Credenciales -> ID de cliente de OAuth 2.0.
# URI de redireccion autorizada: http://localhost:8080/login/oauth2/code/google
#
# No pueden quedar vacias: Spring aborta el arranque con "Client id of
# registration 'google' must not be empty". Si todavia no tienes credenciales,
# deja el texto de abajo: el login nativo funciona igual y lo unico que falla
# es intentar entrar con Google.
GOOGLE_CLIENT_ID=pendiente-de-google-cloud-console
GOOGLE_CLIENT_SECRET=pendiente-de-google-cloud-console

# Secreto para firmar el JWT propio. Minimo 32 caracteres.
# Generar uno nuevo, nunca reutilizar este fichero de ejemplo.
POLARIS_JWT_SECRETO=
POLARIS_JWT_EXPIRACION=43200

# Para construir el enlace de verificacion de email. Opcional: por defecto
# http://localhost:8080. Cambiar cuando haya un dominio real.
POLARIS_URL_BASE=http://localhost:8080

# SMTP. SOLO hace falta con el perfil prod: en dev el enlace de verificacion
# se escribe en el log y nada de esto se lee.
# Con Gmail el usuario es tu correo y la password es una "contrasena de
# aplicacion" (Cuenta de Google -> Seguridad -> Verificacion en dos pasos ->
# Contrasenas de aplicaciones), nunca la de tu cuenta.
POLARIS_SMTP_HOST=smtp.gmail.com
POLARIS_SMTP_PUERTO=587
POLARIS_SMTP_USUARIO=
POLARIS_SMTP_PASSWORD=
POLARIS_CORREO_REMITENTE=no-reply@polaris.local

# TMDB, para buscar peliculas y series (B3). Es el "API Read Access Token"
# (v4) de themoviedb.org -> Ajustes -> API, NO la api_key de v3.
# Opcional: sin el la aplicacion arranca igual y la busqueda responde 400.
POLARIS_TMDB_TOKEN=
